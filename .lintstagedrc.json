{
  "packages/ui-core/**/*.{js,jsx,ts,tsx}": [
    "pnpm --filter @jhonatankennedy/ui-core exec eslint --fix"
  ],
  "packages/ui-react/**/*.{js,jsx,ts,tsx}": [
    "pnpm --filter @jhonatankennedy/ui-react exec eslint --fix"
  ],
  "packages/ui-next/**/*.{js,jsx,ts,tsx}": [
    "pnpm --filter @jhonatankennedy/ui-next exec eslint --fix"
  ],
  "apps/playground-react/**/*.{js,jsx,ts,tsx}": [
    "pnpm --filter @jhonatankennedy/playground-react exec eslint --fix"
  ],
  "apps/playground-next/**/*.{js,jsx,ts,tsx}": [
    "pnpm --filter @jhonatankennedy/playground-next exec eslint --fix"
  ],
  "eslint.config.js": ["pnpm exec eslint --fix"],
  "commitlint.config.js": ["pnpm exec eslint --fix"],
  "*": ["pnpm exec prettier --write --ignore-unknown"]
}
