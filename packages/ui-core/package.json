{
  "name": "@jhonatankennedy/ui-core",
  "private": false,
  "version": "0.6.3",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./tokens": {
        "types": "./dist/tokens.d.ts",
        "import": "./dist/tokens.js"
      },
      "./styles.css": "./dist/index.css"
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.ts",
    "./tokens": "./src/tokens.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:styles": "sass src/styles/reset.scss dist/styles/reset.css --no-source-map"
  },
  "dependencies": {
    "lit": "^3.3.3",
    "lucide-static": "^1.23.0"
  },
  "devDependencies": {
    "@vitest/browser": "^4.1.10",
    "playwright": "^1.61.1",
    "sass": "^1.101.0",
    "typescript": "~6.0.3",
    "vite": "^8.1.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  }
}
